{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
        "plugins": [
          {
            "name": "@nestjs/swagger",
            "options": {
              "classValidatorShim": true,
              "introspectComments": true,
              "dtoFileNameSuffix": [
                ".dto.ts",
                ".entity.ts"
              ]
            }
          }
        ]
      }
    },
    "automation-service": {
      "type": "application",
      "root": "apps/automation-service",
      "entryFile": "main",
      "sourceRoot": "apps/automation-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/automation-service/tsconfig.app.json"
      }
    },
    "catalog-service": {
      "type": "application",
      "root": "apps/catalog-service",
      "entryFile": "main",
      "sourceRoot": "apps/catalog-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/catalog-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json",
        "plugins": [
          {
            "name": "@nestjs/swagger",
            "options": {
              "classValidatorShim": true,
              "introspectComments": true,
              "dtoFileNameSuffix": [
                ".dto.ts",
                ".entity.ts"
              ]
            }
          }
        ]
      }
    },
    "device-registry-service": {
      "type": "application",
      "root": "apps/device-registry-service",
      "entryFile": "main",
      "sourceRoot": "apps/device-registry-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/device-registry-service/tsconfig.app.json"
      }
    },
    "garden-service": {
      "type": "application",
      "root": "apps/garden-service",
      "entryFile": "main",
      "sourceRoot": "apps/garden-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/garden-service/tsconfig.app.json"
      }
    },
    "iam-service": {
      "type": "application",
      "root": "apps/iam-service",
      "entryFile": "main",
      "sourceRoot": "apps/iam-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/iam-service/tsconfig.app.json"
      }
    },
    "mongo": {
      "type": "library",
      "root": "libs/mongo",
      "entryFile": "index",
      "sourceRoot": "libs/mongo/src",
      "compilerOptions": {
        "tsConfigPath": "libs/mongo/tsconfig.lib.json"
      }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-service/tsconfig.app.json"
      }
    },
    "order-fulfillment-service": {
      "type": "application",
      "root": "apps/order-fulfillment-service",
      "entryFile": "main",
      "sourceRoot": "apps/order-fulfillment-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/order-fulfillment-service/tsconfig.app.json"
      }
    },
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    },
    "redis": {
      "type": "library",
      "root": "libs/redis",
      "entryFile": "index",
      "sourceRoot": "libs/redis/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis/tsconfig.lib.json"
      }
    },
    "telemetry-service": {
      "type": "application",
      "root": "apps/telemetry-service",
      "entryFile": "main",
      "sourceRoot": "apps/telemetry-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/telemetry-service/tsconfig.app.json"
      }
    },
    "util": {
      "type": "library",
      "root": "libs/util",
      "entryFile": "index",
      "sourceRoot": "libs/util/src",
      "compilerOptions": {
        "tsConfigPath": "libs/util/tsconfig.lib.json"
      }
    }
  }
}