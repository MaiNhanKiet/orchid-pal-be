generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model automation_rules {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zone_id      String?        @db.Uuid
  name         String?        @db.VarChar(100)
  is_active    Boolean?       @default(true)
  logic_config Json
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  balcony_zones balcony_zones? @relation(fields: [zone_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model cart_items {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  product_id  String?   @db.Uuid
  quantity    Int?      @default(1)
  is_selected Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  products    products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model devices {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serial_number    String          @unique @db.VarChar(100)
  secret_key       String          @db.VarChar(100)
  product_id       String?         @db.Uuid
  owner_id         String?         @db.Uuid
  zone_id          String?         @db.Uuid
  linked_master_id String?         @db.Uuid
  status           String?         @default("INACTIVE") @db.VarChar(20)
  current_firmware String?         @db.VarChar(20)
  last_online_at   DateTime?       @db.Timestamp(6)
  created_at       DateTime?       @default(now()) @db.Timestamp(6)
  hardware_config  Json?
  devices          devices?        @relation("devicesTodevices", fields: [linked_master_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_devices    devices[]       @relation("devicesTodevices")
  users            users?          @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products         products?       @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  balcony_zones    balcony_zones?  @relation(fields: [zone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model firmware_versions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version            String    @db.VarChar(20)
  file_url           String
  target_product_sku String?   @db.VarChar(50)
  is_mandatory       Boolean?  @default(false)
  created_by         String?   @db.Uuid
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  users              users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model my_plants {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?        @db.Uuid
  zone_id        String?        @db.Uuid
  nickname       String?        @db.VarChar(100)
  species_id     String?        @db.Uuid
  planted_at     DateTime?      @db.Date
  health_status  String?        @default("GOOD") @db.VarChar(20)
  image_url      String?
  container_type String?        @db.VarChar(50)
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  plant_wiki     plant_wiki?    @relation(fields: [species_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users?         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  balcony_zones  balcony_zones? @relation(fields: [zone_id], references: [id], onUpdate: NoAction)
}

model order_items {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String?   @db.Uuid
  product_id            String?   @db.Uuid
  product_name_snapshot String?   @db.VarChar(200)
  quantity              Int
  unit_price            Decimal   @db.Decimal(15, 2)
  total_price           Decimal?  @db.Decimal(15, 2)
  orders                orders?   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products              products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?           @db.Uuid
  order_code      String            @unique @db.VarChar(20)
  total_amount    Decimal           @db.Decimal(15, 2)
  status          String?           @db.VarChar(20)
  shipping_info   Json?
  note            String?
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  order_items     order_items[]
  users           users?            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_reviews product_reviews[]
  shipments       shipments[]
  transactions    transactions[]
}

model permissions {
  id               Int                @id @default(autoincrement())
  slug             String             @unique @db.VarChar(100)
  description      String?
  role_permissions role_permissions[]
}

model balcony_zones {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?            @db.Uuid
  name                String             @db.VarChar(100)
  sunlight_intensity  String?            @db.VarChar(50)
  has_roof            Boolean?           @default(false)
  location_city       String?            @db.VarChar(100)
  image_url           String?
  created_at          DateTime?          @default(now()) @db.Timestamp(6)
  automation_rules    automation_rules[]
  devices             devices[]
  my_plants           my_plants[]
  users               users?             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_reviews {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String?   @db.Uuid
  user_id    String?   @db.Uuid
  order_id   String?   @db.Uuid
  rating     Int?
  comment    String?
  images     Json?
  is_hidden  Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  orders     orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products   products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model products {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku             String            @unique @db.VarChar(50)
  name            String            @db.VarChar(200)
  description     String?
  price           Decimal           @db.Decimal(15, 2)
  stock_quantity  Int?              @default(0)
  specs_config    Json?
  image_url       String?
  is_published    Boolean?          @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  cart_items      cart_items[]
  devices         devices[]
  order_items     order_items[]
  product_reviews product_reviews[]
}

model role_permissions {
  role_id       Int
  permission_id Int
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(50)
  description      String?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shipments {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id              String?   @db.Uuid
  carrier_name          String?   @db.VarChar(50)
  tracking_code         String?   @db.VarChar(100)
  shipping_fee          Decimal?  @db.Decimal(15, 2)
  status                String?   @db.VarChar(20)
  estimated_delivery_at DateTime? @db.Timestamp(6)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  orders                orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model plant_wiki {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  common_name      String      @db.VarChar(100)
  scientific_name  String?     @db.VarChar(100)
  plant_category   String?     @db.VarChar(50)
  ideal_temp_min   Float?
  ideal_temp_max   Float?
  ideal_humid_min  Float?
  ideal_humid_max  Float?
  care_instruction String?
  image_url        String?
  author_id        String?     @db.Uuid
  my_plants        my_plants[]
  users            users?      @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id         String?   @db.Uuid
  user_id          String?   @db.Uuid
  amount           Decimal?  @db.Decimal(15, 2)
  method           String?   @db.VarChar(50)
  status           String?   @db.VarChar(20)
  gateway_trans_id String?   @db.VarChar(100)
  gateway_log      Json?
  paid_at          DateTime? @db.Timestamp(6)
  orders           orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_addresses {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?  @db.Uuid
  recipient_name  String?  @db.VarChar(100)
  phone           String?  @db.VarChar(20)
  street          String?  @db.VarChar(255)
  ward            String?  @db.VarChar(100)
  district        String?  @db.VarChar(100)
  city            String?  @db.VarChar(100)
  full_address    String?
  is_default      Boolean? @default(false)
  type            String?  @db.VarChar(20)
  ghn_district_id Int?
  ghn_ward_code   String?  @db.VarChar(20)
  shipping_fee    Int?
  users           users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_roles {
  user_id String @db.Uuid
  role_id Int
  roles   roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
}

model users {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String              @unique @db.VarChar(255)
  password_hash     String              @db.VarChar(255)
  full_name         String?             @db.VarChar(100)
  phone             String?             @db.VarChar(20)
  avatar_url        String?
  preferences       Json?               @default("{}")
  is_active         Boolean?            @default(true)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  cart_items        cart_items[]
  devices           devices[]
  firmware_versions firmware_versions[]
  my_plants         my_plants[]
  orders            orders[]
  balcony_zones     balcony_zones[]
  product_reviews   product_reviews[]
  refresh_tokens    refresh_tokens[]
  plant_wiki        plant_wiki[]
  transactions      transactions[]
  user_addresses    user_addresses[]
  user_roles        user_roles[]
}

model refresh_tokens {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token        String    @unique
  user_id      String    @db.Uuid
  device_agent String?
  ip_address   String?   @db.VarChar(45)
  is_revoked   Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  expires_at   DateTime  @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_refresh_token")
}
