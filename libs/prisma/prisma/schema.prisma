generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String                 @unique @db.VarChar(255)
  password_hash          String                 @db.VarChar(255)
  full_name              String?                @db.VarChar(100)
  phone                  String?                @db.VarChar(20)
  avatar_url             String?
  preferences            Json?                  @default("{}")
  is_active              Boolean?               @default(true)
  created_at             DateTime?              @default(now()) @db.Timestamp(6)
  updated_at             DateTime?              @default(now()) @db.Timestamp(6)
  ai_chat_sessions       ai_chat_sessions[]
  audit_logs             audit_logs[]
  devices                devices[]
  expert_blogs           expert_blogs[]         @relation("expert_blog_author")
  reviewed_blogs         expert_blogs[]         @relation("expert_blog_reviewer")
  archived_conversations expert_conversations[] @relation("archived_conversations")
  expert_conversations   expert_conversations[] @relation("customer_conversations")
  expert_as_expert       expert_conversations[] @relation("expert_conversations")
  expert_messages        expert_messages[]
  expert_profile         expert_profiles?
  feedbacks              feedbacks[]
  my_plants              my_plants[]
  notifications          notifications[]
  refresh_tokens         refresh_tokens[]
  user_roles             user_roles[]
}

model expert_profiles {
  user_id          String    @id @db.Uuid
  specialty        String?   @db.VarChar(200)
  bio              String?
  location         String?   @db.VarChar(100)
  tags             Json?     @default("[]")
  experience_years Int?
  is_available     Boolean?  @default(true)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model roles {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(50)
  description      String?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model permissions {
  id               Int                @id @default(autoincrement())
  slug             String             @unique @db.VarChar(100)
  description      String?
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       Int
  permission_id Int
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model user_roles {
  user_id String @db.Uuid
  role_id Int
  roles   roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
}

model refresh_tokens {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token        String    @unique
  user_id      String?   @db.Uuid
  device_agent String?
  ip_address   String?   @db.VarChar(45)
  is_revoked   Boolean?  @default(false)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  expires_at   DateTime  @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  users        users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model products {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku           String    @unique @db.VarChar(50)
  name          String    @db.VarChar(200)
  description   String?
  price         Decimal   @db.Decimal(15, 2)
  image_url     String?
  is_published  Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  buy_link      String?
  features_json Json?
}

model my_plants {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String?                @db.Uuid
  nickname                String                 @db.VarChar(100)
  planted_at              DateTime?              @db.Date
  created_at              DateTime?              @default(now()) @db.Timestamp(6)
  ai_space_analysis       Json?
  ai_suggested_thresholds Json?
  location_city           String?                @db.VarChar(100)
  setup_image_url         String?
  species_name            String?                @db.VarChar(100)
  updated_at              DateTime?              @default(now()) @db.Timestamp(6)
  ai_chat_sessions        ai_chat_sessions[]
  devices                 devices?
  expert_conversations    expert_conversations[]
  users                   users?                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ai_chat_sessions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String             @db.Uuid
  topic            String?            @default("New Conversation") @db.VarChar(200)
  related_plant_id String?            @db.Uuid
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  ai_chat_messages ai_chat_messages[]
  my_plants        my_plants?         @relation(fields: [related_plant_id], references: [id], onUpdate: NoAction)
  users            users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, updated_at(sort: Desc)], map: "idx_ai_chat_sessions_user_updated")
}

model ai_chat_messages {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id       String           @db.Uuid
  role             String           @db.VarChar(20)
  content          String?
  image_url        String?
  created_at       DateTime?        @default(now()) @db.Timestamp(6)
  ai_chat_sessions ai_chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id, created_at], map: "idx_ai_chat_messages_session_created")
}

model devices {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serial_number    String             @unique @db.VarChar(100)
  secret_key       String             @db.VarChar(100)
  owner_id         String?            @db.Uuid
  status           String?            @default("INACTIVE") @db.VarChar(20)
  current_firmware String?            @db.VarChar(20)
  last_online_at   DateTime?          @db.Timestamp(6)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  activated_at     DateTime?          @db.Timestamp(6)
  plant_id         String?            @unique @db.Uuid
  qr_image_url     String?
  automation_rules automation_rules[]
  device_relays    device_relays[]
  users            users?             @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  my_plants        my_plants?         @relation(fields: [plant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model device_relays {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  device_id     String?   @db.Uuid
  relay_port    Int
  name          String?   @db.VarChar(50)
  current_state Boolean?  @default(false)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  devices       devices?  @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([device_id, relay_port])
}

model automation_rules {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String?   @db.VarChar(100)
  is_active    Boolean?  @default(true)
  logic_config Json
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  device_id    String?   @db.Uuid
  relay_port   Int
  rule_type    String?   @db.VarChar(20)
  devices      devices?  @relation(fields: [device_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model firmware_versions {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version       String    @db.VarChar(20)
  file_url      String
  is_mandatory  Boolean?  @default(false)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  release_notes String?
}

model expert_blogs {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id        String?   @db.Uuid
  title            String    @db.VarChar(255)
  slug             String    @unique @db.VarChar(255)
  summary          String?
  content          String
  cover_image_url  String?
  tags             Json?     @default("[]")
  views_count      Int?      @default(0)
  is_published     Boolean?  @default(false)
  published_at     DateTime? @db.Timestamp(6)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  status           String    @default("DRAFT") @db.VarChar(20)
  reviewed_by      String?   @db.Uuid
  reviewed_at      DateTime? @db.Timestamp(6)
  rejection_reason String?
  users            users?    @relation("expert_blog_author", fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewer         users?    @relation("expert_blog_reviewer", fields: [reviewed_by], references: [id], onUpdate: NoAction)

  @@index([slug], map: "idx_blogs_slug")
  @@index([status, created_at(sort: Desc)], map: "idx_expert_blogs_status_created")
}

model feedbacks {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category   String    @db.VarChar(50)
  name       String?   @db.VarChar(120)
  email      String    @db.VarChar(255)
  message    String
  source     String?   @default("landing") @db.VarChar(50)
  user_id    String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_feedbacks_created_at")
}

model audit_logs {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?  @db.Uuid
  username       String?  @db.VarChar(255)
  full_name      String?  @db.VarChar(120)
  role           String?  @db.VarChar(200)
  module         String?  @db.VarChar(100)
  entity         String?  @db.VarChar(100)
  entity_id      String?  @db.VarChar(100)
  action         String   @db.VarChar(100)
  description    String?
  old_data       Json?
  new_data       Json?
  ip_address     String?  @db.VarChar(45)
  user_agent     String?  @db.VarChar(500)
  request_method String?  @db.VarChar(10)
  endpoint       String?  @db.VarChar(500)
  status         String   @default("SUCCESS") @db.VarChar(20)
  response_code  Int?
  duration_ms    Int?
  created_at     DateTime @default(now()) @db.Timestamp(6)
  actor_email    String?  @db.VarChar(255)
  resource       String?  @db.VarChar(100)
  resource_id    String?  @db.VarChar(100)
  metadata       Json?
  users          users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([user_id], map: "idx_audit_logs_user_id")
  @@index([module], map: "idx_audit_logs_module")
  @@index([action], map: "idx_audit_logs_action")
  @@index([entity], map: "idx_audit_logs_entity")
  @@index([status], map: "idx_audit_logs_status")
  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([user_id, created_at(sort: Desc)], map: "idx_audit_logs_user_created")
}

model expert_conversations {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id      String?           @db.Uuid
  expert_id        String?           @db.Uuid
  related_plant_id String?           @db.Uuid
  topic            String?           @db.VarChar(200)
  status           String?           @default("OPEN") @db.VarChar(20)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @default(now()) @db.Timestamp(6)
  archived_at      DateTime?         @db.Timestamp(6)
  archived_by      String?           @db.Uuid
  archiver         users?            @relation("archived_conversations", fields: [archived_by], references: [id], onUpdate: NoAction)
  customer         users?            @relation("customer_conversations", fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expert           users?            @relation("expert_conversations", fields: [expert_id], references: [id], onUpdate: NoAction)
  my_plants        my_plants?        @relation(fields: [related_plant_id], references: [id], onUpdate: NoAction)
  expert_messages  expert_messages[]
}

model expert_messages {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id      String?               @db.Uuid
  sender_id            String?               @db.Uuid
  content              String?
  image_urls           Json?
  is_read              Boolean?              @default(false)
  created_at           DateTime?             @default(now()) @db.Timestamp(6)
  client_message_id    String?               @db.VarChar(64)
  is_deleted           Boolean?              @default(false)
  updated_at           DateTime?             @db.Timestamp(6)
  edited_at            DateTime?             @db.Timestamp(6)
  deleted_at           DateTime?             @db.Timestamp(6)
  expert_conversations expert_conversations? @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                users?                @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(200)
  body       String?
  data       Json?
  is_read    Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read, created_at(sort: Desc)], map: "idx_notifications_user_read")
}
