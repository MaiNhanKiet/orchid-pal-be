{
  "name": "orchid-pal-be",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:all": "nest build api-gateway identity-service plant-service",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    "prisma:pull": "prisma db pull --schema=./libs/prisma/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=./libs/prisma/prisma/schema.prisma",
    "seed:blogs": "ts-node -r tsconfig-paths/register scripts/seed-expert-blogs.ts",
    "seed:blogs:user": "ts-node -r tsconfig-paths/register scripts/seed-blogs-for-user.ts",
    "seed:bootstrap": "ts-node -r tsconfig-paths/register scripts/seed-bootstrap.ts",
    "sync:permissions": "ts-node -r tsconfig-paths/register scripts/seed-bootstrap.ts",
    "docker:build:gateway": "docker build --build-arg APP_NAME=api-gateway -t ${DOCKER_USERNAME:-kietmn}/orchidpal-api-gateway:${IMAGE_TAG:-latest} .",
    "docker:build:identity": "docker build --build-arg APP_NAME=identity-service -t ${DOCKER_USERNAME:-kietmn}/orchidpal-identity-service:${IMAGE_TAG:-latest} .",
    "docker:build:plant": "docker build --build-arg APP_NAME=plant-service -t ${DOCKER_USERNAME:-kietmn}/orchidpal-plant-service:${IMAGE_TAG:-latest} .",
    "docker:build:all": "npm run docker:build:gateway && npm run docker:build:identity && npm run docker:build:plant",
    "docker:push:gateway": "docker push ${DOCKER_USERNAME:-kietmn}/orchidpal-api-gateway:${IMAGE_TAG:-latest}",
    "docker:push:identity": "docker push ${DOCKER_USERNAME:-kietmn}/orchidpal-identity-service:${IMAGE_TAG:-latest}",
    "docker:push:plant": "docker push ${DOCKER_USERNAME:-kietmn}/orchidpal-plant-service:${IMAGE_TAG:-latest}",
    "docker:push:all": "npm run docker:push:gateway && npm run docker:push:identity && npm run docker:push:plant",
    "docker:release": "bash scripts/docker-hub-release.sh",
    "start:all": "concurrently \"npm run start:dev identity-service\" \"npm run start:dev api-gateway\"",
    "dev": "concurrently -k -p \"[{name}]\" -n \"GATEWAY,IDENTITY,PLANT\" -c \"cyan,green,magenta\" \"npm run start:dev api-gateway\" \"npm run start:dev identity-service\" \"npm run start:dev plant-service\""
  },
  "dependencies": {
    "@bull-board/api": "^6.16.4",
    "@bull-board/express": "^6.16.4",
    "@bull-board/nestjs": "^6.16.4",
    "@google/genai": "^1.46.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.12",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/websockets": "^11.1.27",
    "@payos/node": "^2.0.4",
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^7.0.11",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "axios": "^1.13.6",
    "bullmq": "^5.67.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudinary": "^1.41.0",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.9.2",
    "mongoose": "^9.3.0",
    "mqtt": "^5.10.4",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/mongo(|/.*)$": "<rootDir>/libs/mongo/src/$1",
      "^@app/prisma(|/.*)$": "<rootDir>/libs/prisma/src/$1",
      "^@app/redis(|/.*)$": "<rootDir>/libs/redis/src/$1",
      "^@app/util(|/.*)$": "<rootDir>/libs/util/src/$1",
      "^@app/grpc(|/.*)$": "<rootDir>/libs/grpc/src/$1"
    }
  }
}
