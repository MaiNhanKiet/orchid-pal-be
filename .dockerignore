# Dependencies & local tooling
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.cache
.ci-home

# Git / IDE
.git
.gitignore
.github
.idea
.vscode
*.md
!README.md

# Env & secrets — never bake into image
.env
.env.*
!.env.example

# Build artifacts from host (rebuild inside Docker)
dist
coverage
.nyc_output

# Tests / scripts not needed at runtime
**/test
**/*.spec.ts
**/*.e2e-spec.ts
docs
scripts

# Local docker / compose noise
Dockerfile*
compose*.yaml
compose*.yml
docker-compose*.yml
.dockerignore
