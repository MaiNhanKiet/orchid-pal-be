# =============================================================================
# OrchidPal BE — Arcane / Docker Compose .env template
# Copy into Arcane project → Environment (.env). Replace every replace-me value.
# Do NOT commit real secrets. Names match source code (apps + libs).
# =============================================================================

# ── Docker images (npm run docker:release → Arcane pulls) ────────────────────
DOCKER_USERNAME=kietmn
IMAGE_TAG=latest
# Bản dán Arcane đầy đủ: docker/apps/.env.example
# Infra: docker/infra/ | Web: docker/web/

# ── API Gateway (only public port) ───────────────────────────────────────────
API_GATEWAY_PORT=3000
API_GATEWAY_PUBLIC_PORT=3000

# ── Internal Nest microservices (Docker DNS names = Compose service names) ───
IDENTITY_SERVICE_HOST=identity-service
IDENTITY_SERVICE_PORT=3001
PLANT_SERVICE_HOST=plant-service
PLANT_SERVICE_PORT=3002

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
DEFAULT_USER_ROLE=CUSTOMER
FRONTEND_URL=https://your-frontend.example.com

# ── PostgreSQL (Prisma — libs/prisma) ────────────────────────────────────────
# Use Docker DNS hostname if Postgres is on the same Arcane/Compose network,
# otherwise use the remote host reachable from the VPS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ── MongoDB (libs/mongo — plant telemetry/automation) ────────────────────────
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/DATABASE?authSource=admin

# ── Redis / BullMQ (libs/redis — api-gateway + identity) ─────────────────────
REDIS_URL=redis://:PASSWORD@HOST:6379

# ── RabbitMQ (libs/common RmqService — api-gateway + plant) ──────────────────
RABBITMQ_USER=replace-me
RABBITMQ_PASS=replace-me
RABBITMQ_HOST=replace-me-host
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=orchidpal

# ── MQTT (plant-service only) ────────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://HOST:1883
MQTT_BROKER_USERNAME=replace-me
MQTT_BROKER_PASSWORD=replace-me

# ── JWT (libs/common jwt.config + identity auth + gateway guards) ────────────
# JWT_SECRET is optional; JwtModule falls back to JWT_ACCESS_TOKEN_SECRET.
JWT_SECRET=
JWT_ACCESS_TOKEN_SECRET=replace-with-long-random-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-long-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=604800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_EXPIRES_IN=

# ── Google OAuth (api-gateway only) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=https://your-api.example.com/auth/google/callback

# ── Cloudinary (api-gateway uploads) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# ── Gemini (api-gateway AI care + plant-service vision) ───────────────────────
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=replace-me
